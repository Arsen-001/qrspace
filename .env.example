# Вход только через Google и Apple. Скопируйте в .env.local и заполните (секреты в git не кладём).

# Адрес сайта (для обратных ссылок Google/Apple), без «/» в конце. На этом компьютере можно не задавать.
APP_URL=https://qrspace.co
# Случайная строка 32+ символа — подпись входа. Сгенерировать: openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: https://<сайт>/api/auth/google/callback (и http://localhost:3720/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Developer ($99/год) → Identifiers → Services ID (это APPLE_CLIENT_ID), «Sign in with Apple»,
# Return URL: https://<сайт>/api/auth/apple/callback (Apple не принимает localhost — только настоящий домен с https).
# Keys → ключ с «Sign in with Apple» → APPLE_KEY_ID и файл .p8 (его текст — в APPLE_PRIVATE_KEY, переносы как \n).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# База данных (Postgres). Пусто — данные в файле .data/db.json (только для этого компьютера: на хостинге файлы не
# сохраняются). Например, Neon или Supabase из Vercel Marketplace. Таблица создаётся сама.
DATABASE_URL=

# Демо-вход (выбрать человека) — для проверки. На настоящем сайте: off.
DEMO_LOGIN=on
# Вход проверяющих App Store / Google Play (docs/store/REVIEW-LOGIN.md): логин и код (не короче 8 знаков). Оба заданы —
# на входе из приложения есть «Вход по коду проверки» → аккаунт «App Review» с примерами кодов. Пусто — выключен.
REVIEW_LOGIN=
REVIEW_LOGIN_CODE=
# Почты администраторов (через запятую): жалобы, блокировка кодов, общие цифры (/admin).
ADMIN_EMAILS=
# Почты дизайнеров (через запятую): им — «Опубликовать в маркет» и заказы брендов.
DESIGNER_EMAILS=

# Оператор сайта — в «Условиях», «Конфиденциальности», «Возвратах» (раздел «Контакты»).
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_EMAIL=

# Приложения: ссылки кодов (/K/…, /c/…) открываются сразу в приложении.
# iPhone — «TEAMID.co.qrspace.app» (Team ID — в Apple Developer → Membership), через запятую, если несколько.
APPLE_APP_IDS=
# Android — «co.qrspace.app:AA:BB:…» (отпечаток SHA-256 ключа подписи из Play Console → App integrity), несколько — через «|».
ANDROID_APP_LINKS=

# Уведомления на телефон. Пусто — не отправляем.
# iPhone: Apple Developer → Keys → ключ с «Apple Push Notifications service (APNs)» → APNS_KEY_ID и файл .p8
# (его текст — в APNS_PRIVATE_KEY, переносы как \n); APNS_TEAM_ID — Team ID. APNS_SANDBOX=1 — для сборок из Xcode.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=co.qrspace.app
APNS_SANDBOX=
# Android: Firebase → Project settings → Service accounts → Generate new private key — весь JSON одной строкой.
FCM_SERVICE_ACCOUNT=

# Встроенная оплата в приложениях. Apple — ключей не нужно: покупку проверяем по подписи Apple (корень Apple Root CA - G3).
# Google Play: Play Console → Setup → API access → сервисный аккаунт с правом «View financial data, manage orders» —
# весь JSON одной строкой (можно тот же Google Cloud-проект, что и Firebase).
GOOGLE_PLAY_SERVICE_ACCOUNT=
