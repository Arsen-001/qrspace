# Вход только через Google и Apple. Скопируйте в .env.local и заполните (секреты в git не кладём).

# Адрес сайта (для обратных ссылок Google/Apple), без «/» в конце. На этом компьютере можно не задавать.
APP_URL=https://qrvivid.com
# Случайная строка 32+ символа — подпись входа. Сгенерировать: openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: https://<сайт>/api/auth/google/callback (и http://localhost:3720/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Developer ($99/год) → Identifiers → Services ID (это APPLE_CLIENT_ID), «Sign in with Apple»,
# Return URL: https://<сайт>/api/auth/apple/callback (Apple не принимает localhost — только настоящий домен с https).
# Keys → ключ с «Sign in with Apple» → APPLE_KEY_ID и файл .p8 (его текст — в APPLE_PRIVATE_KEY, переносы как \n).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Демо-вход (выбрать человека) — для проверки. На настоящем сайте: off.
DEMO_LOGIN=on
# Почты дизайнеров (через запятую): им — «Опубликовать в маркет» и заказы брендов.
DESIGNER_EMAILS=
