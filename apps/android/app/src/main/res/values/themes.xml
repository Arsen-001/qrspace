<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="stage">#0B0B0C</color>
    <color name="bg_light">#EDEBE4</color>
    <color name="lime">#C6FF2E</color>
    <!-- Compose draws everything; the window theme only sets the first frame and system bars. -->
    <style name="Theme.QRSpace" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
