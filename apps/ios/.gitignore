# Generated by XcodeGen from project.yml
*.xcodeproj/
# Build output
build/
DerivedData/
*.xcresult
xcuserdata/
.swiftpm/
# Simulator screenshots and test images; also fastlane/screenshots (App Store shots, ~46 MB — regenerate with
# node apps/ios/fastlane/shots/take.mjs)
screenshots/
.testdata/
# fastlane run output (the .ipa goes to build/ipa)
fastlane/report.xml
fastlane/README.md
fastlane/Preview.html
fastlane/test_output/
# Логин и код проверяющих App Review — пишет fastlane/metadata.mjs из ~/.qrspace/review-login.env
fastlane/metadata/review_information/demo_user.txt
fastlane/metadata/review_information/demo_password.txt
