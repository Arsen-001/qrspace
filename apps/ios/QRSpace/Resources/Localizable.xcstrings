            "value": "Сканов пока нет. Всё, что отсканируете, останется здесь — только на этом телефоне."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սկաններ դեռ չկան։ Ամեն ինչ, ինչ սկանավորեք, կմնա այստեղ՝ միայն այս հեռախոսում։"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay escaneos. Todo lo que escanees queda aquí, solo en este teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma leitura ainda. Tudo o que você ler fica aqui, só neste telefone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun scan pour l’instant. Tout ce que vous scannez reste ici, sur ce téléphone uniquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Scans. Alles, was du scannst, bleibt hier – nur auf diesem Telefon."
          }
        }
      }
    },
