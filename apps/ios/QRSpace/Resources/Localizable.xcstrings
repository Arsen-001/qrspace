    "providersPending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google and Apple sign-in will work once the keys are connected — for now there is a demo sign-in below."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход через Google и Apple заработает, когда подключим ключи — пока для проверки есть демо-вход ниже."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Google-ով և Apple-ով մուտքը կաշխատի, երբ միացնենք բանալիները — առայժմ ստուգման համար ստորև կա դեմո մուտք։"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso con Google y Apple funcionará cuando conectemos las claves — por ahora hay un acceso de prueba abajo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O login com Google e Apple vai funcionar quando conectarmos as chaves — por enquanto há um login de teste abaixo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion Google et Apple fonctionnera une fois les clés branchées — en attendant, une connexion de test est disponible ci-dessous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Google und Apple funktioniert, sobald die Schlüssel verbunden sind — bis dahin gibt es unten eine Test-Anmeldung."
          }
        }
      }
    },
