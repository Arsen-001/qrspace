        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեսնում են միայն ձեր կոնտակտները — ստորև ցուցակը, ընդհանուր ձեր բոլոր կոդերի համար"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la ven tus contactos — la lista de abajo es común para todos tus códigos"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os seus contatos veem — a lista abaixo vale para todos os seus códigos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls vos contacts la voient — la liste ci-dessous est commune à tous vos codes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur deine Kontakte sehen sie — die Liste unten gilt für alle deine Codes"
          }
        }
      }
    },
    "visHint.me": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody but you. A scan shows “This code is private”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто, кроме вас. Скан покажет «Код закрыт»"
