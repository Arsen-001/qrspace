    "storageMonthly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space is monthly; the code itself works forever. Not renewed — back to 1 MB: what's there stays, but you can't add more."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место — помесячно, сам код работает всегда. Не продлили — останется 1 МБ: что уже лежит, не пропадёт, но новое не добавить."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեղը ամսական է, կոդն ինքը աշխատում է միշտ։ Չերկարացրիք՝ կմնա 1 ՄԲ. եղածը չի կորչի, բայց նորը չեք ավելացնի։"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio es mensual; el código funciona siempre. Sin renovar vuelve a 1 MB: lo que hay se queda, pero no podrás añadir más."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço é mensal; o código funciona para sempre. Sem renovar volta a 1 MB: o que existe fica, mas não dá para adicionar mais."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace est mensuel ; le code fonctionne pour toujours. Sans renouvellement, retour à 1 Mo : ce qui existe reste, mais rien de nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platz ist monatlich, der Code selbst funktioniert immer. Nicht verlängert — wieder 1 MB: Vorhandenes bleibt, Neues kannst du nicht hinzufügen."
