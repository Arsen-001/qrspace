            "state": "translated",
            "value": "Sí, eliminar para siempre"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim, excluir para sempre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, supprimer pour toujours"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, für immer löschen"
          }
        }
      }
    },
