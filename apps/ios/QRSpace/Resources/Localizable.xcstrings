    "wifiHow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Wi-Fi settings, pick this network and paste the password."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте настройки Wi-Fi, выберите эту сеть и вставьте пароль."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բացեք Wi-Fi-ի կարգավորումները, ընտրեք այս ցանցը և տեղադրեք գաղտնաբառը։"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los ajustes de Wi-Fi, elige esta red y pega la contraseña."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra as configurações de Wi-Fi, escolha esta rede e cole a senha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez les réglages Wi-Fi, choisissez ce réseau et collez le mot de passe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die WLAN-Einstellungen, wähle dieses Netz und füge das Passwort ein."
          }
        }
      }
    },
