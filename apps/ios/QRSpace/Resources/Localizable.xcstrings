        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսպես այն կկոչվի «Իմ կոդերում»։ Թողեք դատարկ՝ կանվանենք ըստ պարունակության։"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su nombre en Mis códigos. Déjalo vacío y lo nombraremos según el contenido."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome dele em Meus códigos. Deixe vazio — damos o nome pelo conteúdo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son nom dans Mes codes. Laissez vide — on le nomme d’après son contenu."
