        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est une démo pour l’instant — aucun argent n’est débité. Les prix sont indicatifs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung ist vorerst eine Demo — es wird kein Geld abgebucht. Die Preise sind ungefähr."
          }
        }
      }
    },
