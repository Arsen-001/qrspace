    "firstCodeText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A link, Wi-Fi, a contact or a code with memory — a couple of minutes and it's here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка, Wi-Fi, контакт или код с памятью — пара минут, и он здесь."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հղում, Wi-Fi, կոնտակտ կամ հիշողությամբ կոդ՝ մի քանի րոպե, և այն այստեղ է։"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace, Wi-Fi, un contacto o un código con memoria: un par de minutos y estará aquí."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link, Wi-Fi, um contato ou um código com memória — alguns minutos e ele aparece aqui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien, le Wi-Fi, un contact ou un code avec mémoire — quelques minutes et il est ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Link, WLAN, ein Kontakt oder ein Code mit Erinnerung – ein paar Minuten, und er ist hier."
          }
        }
      }
    },
