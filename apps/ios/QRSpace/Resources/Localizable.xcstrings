    "accLoginText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to see your codes, purchases and packs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы увидеть свои коды, покупки и пакеты."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտք գործեք՝ ձեր կոդերը, գնումներն ու փաթեթները տեսնելու համար։"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para ver tus códigos, compras y packs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre para ver seus códigos, compras e pacotes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour voir vos codes, achats et packs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, um deine Codes, Käufe und Pakete zu sehen."
          }
        }
