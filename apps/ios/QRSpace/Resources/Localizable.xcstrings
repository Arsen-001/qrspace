    "packsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any look — simple or styled. Every code gets its own room for photos, videos and text."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой вид — простой или красивый. Под каждым кодом — своё место для фото, видео и текста."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ցանկացած տեսք՝ պարզ կամ գեղեցիկ։ Յուրաքանչյուր կոդի տակ՝ իր տեղը լուսանկարների, տեսանյութերի և տեքստի համար։"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier diseño, simple o con estilo. Cada código tiene su propio espacio para fotos, vídeos y texto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer visual, simples ou estilizado. Cada código tem seu próprio espaço para fotos, vídeos e texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’importe quel style, simple ou travaillé. Chaque code a son propre espace pour photos, vidéos et texte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Look, schlicht oder gestaltet. Jeder Code bekommt eigenen Platz für Fotos, Videos und Text."
          }
        }
      }
    },
