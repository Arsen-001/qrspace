        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սկաններ դեռ չկան։ Ամեն ինչ, ինչ սկանավորեք, կմնա այստեղ՝ միայն այս հեռախոսում։"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay escaneos. Todo lo que escanees queda aquí, solo en este teléfono."
