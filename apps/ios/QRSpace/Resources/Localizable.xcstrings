    "deleteAccountSure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your account forever? All your codes, memories, photos and videos will be gone. This can’t be undone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить аккаунт навсегда? Пропадут все ваши коды, память, фото и видео. Вернуть нельзя."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ջնջե՞լ հաշիվը ընդմիշտ։ Կվերանան ձեր բոլոր կոդերը, հիշողությունը, լուսանկարները և տեսանյութերը։ Վերադարձնել հնարավոր չէ։"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar tu cuenta para siempre? Desaparecerán todos tus códigos, memorias, fotos y videos. No se puede deshacer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir sua conta para sempre? Todos os seus códigos, memórias, fotos e vídeos vão sumir. Não dá para desfazer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer votre compte pour toujours ? Tous vos codes, mémoires, photos et vidéos disparaîtront. C’est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto für immer löschen? Alle deine Codes, Erinnerungen, Fotos und Videos verschwinden. Das lässt sich nicht rückgängig machen."
          }
        }
      }
    },
    "deleteAccountYes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, delete forever"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
