    "buyDemo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is a demo for now — no money is charged. Prices are approximate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата пока демо — деньги не списываются. Цены примерные."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վճարումը առայժմ դեմո է՝ գումար չի գանձվում։ Գները մոտավոր են։"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago es una demo por ahora — no se cobra dinero. Los precios son aproximados."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento é uma demo por enquanto — nenhum dinheiro é cobrado. Os preços são aproximados."
