            "value": "Էջը չկա, կամ կոդը ջնջել է տերը։ Կարող եք ստեղծել ձերը՝ առաջին պարզ կոդն անվճար է։"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página no existe o su dueño eliminó el código. Crea el tuyo: el primer código simple es gratis."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página não existe ou o dono apagou o código. Crie o seu — o primeiro código simples é grátis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page n'existe pas, ou son propriétaire a supprimé le code. Créez le vôtre : le premier code simple est gratuit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite gibt es nicht, oder der Besitzer hat den Code gelöscht. Mach deinen eigenen – der erste einfache Code ist kostenlos."
          }
        }
      }
    },
