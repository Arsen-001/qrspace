          "stringUnit": {
            "state": "translated",
            "value": "Կոդի տակ՝ ձեր լուսանկարները, տեսանյութերը և տեքստը։ Դուք եք որոշում, թե ով է դրանք տեսնում՝ բոլորը, ընտրված մարդիկ, թե միայն դուք։"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos, videos y textos viven bajo el código. Tú decides quién los ve: todos, personas elegidas o solo tú."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas fotos, vídeos e textos ficam por trás do código. Você decide quem vê: todos, pessoas escolhidas ou só você."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos photos, vidéos et textes vivent derrière le code. Vous décidez qui les voit : tout le monde, des personnes choisies ou vous seul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos, Videos und Texte leben hinter dem Code. Du entscheidest, wer sie sieht: alle, ausgewählte Personen oder nur du."
          }
        }
      }
    },
