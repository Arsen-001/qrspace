    "visHint.all": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who scans the code sees the memory — even without signing in"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Память видит любой, кто отсканировал код, — даже без входа"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հիշողությունը տեսնում է ամեն մեկը, ով սկանավորել է կոդը, — նույնիսկ առանց մուտքի"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera que escanee el código ve la memoria — incluso sin entrar"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa que escanear o código vê a memória — mesmo sem entrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiconque scanne le code voit la mémoire — même sans connexion"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder, der den Code scannt, sieht die Erinnerung — auch ohne Anmeldung"
          }
        }
      }
    },
