            "state": "translated",
            "value": "Entre para ver seus códigos, compras e pacotes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour voir vos codes, achats et packs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
